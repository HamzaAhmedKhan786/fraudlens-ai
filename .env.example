ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fraudlens:fraudlens@localhost:5432/fraudlens
API_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
PROCESSING_INLINE=true
MAX_UPLOAD_BYTES=52428800
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=.data/objects
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=fraudlens
OBJECT_STORAGE_SECRET_KEY=fraudlens-dev-password
OBJECT_STORAGE_BUCKET=fraudlens-evidence
OBJECT_STORAGE_SECURE=false
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
UPLOAD_RETENTION_DAYS=30
METADATA_RETENTION_DAYS=180
LLM_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=ollama
AGENT_TIMEOUT_SECONDS=30
KNOWLEDGE_BASE_PATH=docs/knowledge-base
KNOWLEDGE_MAX_CHUNKS=4
KNOWLEDGE_MIN_RELEVANCE=0.25
FRAUDLENS_API_URL=http://localhost:8000/api/v1
FRAUDLENS_API_KEY=replace-with-the-same-value-as-api-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
OAUTH_STATE_TTL_SECONDS=600
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHM=RS256
OIDC_TENANT_CLAIM=https://fraudlens.example/tenant_id
OIDC_ROLES_CLAIM=https://fraudlens.example/roles
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_LOGOUT_URL=
OIDC_RECOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Legacy provider-neutral callback. Auth0 SDK v4 uses APP_BASE_URL/auth/callback.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Auth0 Next.js SDK v4 (used by Docker Compose web service; host web uses apps/web/.env.local)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-application-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-application-client-secret
AUTH0_SECRET=replace-with-a-32-byte-hex-session-secret
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.fraudlens.example
AUTH0_SCOPE=openid profile email offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/connectors/microsoft/callback
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_SMALL_MONTHLY=
STRIPE_PRICE_SMALL_ANNUAL=
STRIPE_PRICE_MEDIUM_MONTHLY=
STRIPE_PRICE_MEDIUM_ANNUAL=
SUBSCRIPTION_TRIAL_DAYS=14
OCR_ENABLED=false
OCR_LANGUAGES=eng+deu+spa+ita+urd+fra+ara
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=.data/tessdata
POPPLER_PATH=
OCR_MAX_PAGES=20
VIDEO_INFERENCE_ENABLED=false
VIDEO_INFERENCE_URL=
VIDEO_INFERENCE_MODEL=unconfigured
