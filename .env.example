ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fraudlens:fraudlens@localhost:5432/fraudlens
API_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
PROCESSING_INLINE=true
MAX_UPLOAD_BYTES=52428800
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=.data/objects
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=fraudlens
OBJECT_STORAGE_SECRET_KEY=fraudlens-dev-password
OBJECT_STORAGE_BUCKET=fraudlens-evidence
OBJECT_STORAGE_SECURE=false
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
UPLOAD_RETENTION_DAYS=30
METADATA_RETENTION_DAYS=180
LLM_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
FRAUDLENS_API_URL=http://localhost:8000/api/v1
FRAUDLENS_API_KEY=replace-with-the-same-value-as-api-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
OCR_ENABLED=false
OCR_LANGUAGES=eng+deu+spa+ita+urd+fra+ara
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=.data/tessdata
POPPLER_PATH=
OCR_MAX_PAGES=20
VIDEO_INFERENCE_ENABLED=false
VIDEO_INFERENCE_URL=
VIDEO_INFERENCE_MODEL=unconfigured
