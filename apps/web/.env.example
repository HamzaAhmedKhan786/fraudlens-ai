# These values are read only by the Next.js server. Do not prefix the API key
# with NEXT_PUBLIC_, because that would expose it to browser JavaScript.
FRAUDLENS_API_URL=http://127.0.0.1:8000/api/v1
FRAUDLENS_API_KEY=replace-with-the-same-value-as-root-api-key

# Auth0 Next.js SDK v4. Never prefix these with NEXT_PUBLIC_.
OIDC_ENABLED=false
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-application-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-application-client-secret
AUTH0_SECRET=replace-with-a-32-byte-hex-session-secret
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.fraudlens.example
AUTH0_SCOPE=openid profile email offline_access
OIDC_RECOVERY_URL=
